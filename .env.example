# ════════════════════════════════════════════════════════════════════════════
# DS PATH System - Environment Variables Template
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to server/.env and fill in your actual values
# Never commit .env files to version control!

# ── Database Configuration ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_database_password
DB_NAME=path_db
# Optional: Path to SSL certificate for database connection
DB_CA_CERT_PATH=./certs/ca.pem

# ── Application Server ────────────────────────────────────────────────────────
PORT=5000
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
APP_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# ── CORS Configuration ────────────────────────────────────────────────────────
# Set to specific origin in production (e.g., https://yourdomain.com)
# Use * for development (allows all origins)
CORS_ORIGIN=*

# ── Server-Side Rendering (SSR) ───────────────────────────────────────────────
# Enable SSR for public pages (login, register, etc.)
# - true: Server renders HTML (better SEO, faster initial load)
# - false: Client-side rendering only (default)
# Note: Requires running 'npm run build:all' in client directory first
ENABLE_SSR=false

# ── Email Service (Brevo / Sendinblue) ────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM=noreply@yourdomain.com
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=DS PATH System
# Legacy mail config (if not using Brevo)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# ── reCAPTCHA (Google) ────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# ── Cloudflare R2 Storage (S3-compatible) ─────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket.r2.cloudflarestorage.com
